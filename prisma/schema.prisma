// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  SUPERVISOR
  USER
}

enum MessageChannel {
  EMAIL
  SMS
}

enum MessageTemplateType {
  CONFIRMATION
  REMINDER
  REVIEW
  REBOOK
}

enum TriggerType {
  BOOKING_CREATED
  HOURS_BEFORE_BOOKING
  JOB_COMPLETED
  DAYS_SINCE_LAST_BOOKING
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id                              String   @id @default(cuid())
  name                            String
  timezone                        String   @default("Europe/London")
  identifierLabel                 String?
  defaultRebookIntervalDays       Int      @default(30)
  defaultChannel                  MessageChannel @default(EMAIL)
  setupCompleted                  Boolean  @default(false)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  users             User[]
  clients           Client[]
  services          Service[]
  addOns            AddOn[]
  bookings          Booking[]
  messageTemplates  MessageTemplate[]
  automationRules   AutomationRule[]

  @@map("businesses")
}

model User {
  id                      String   @id @default(cuid())
  businessId              String
  email                   String   @unique
  passwordHash            String
  name                    String
  role                    Role     @default(USER)
  emailVerified           Boolean  @default(false)
  emailVerificationToken  String?
  emailVerificationSentAt DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([email])
  @@map("users")
}

model Client {
  id              String    @id @default(cuid())
  businessId      String
  fullName        String
  phone           String?
  email           String?
  address         String?
  identifierValue String?
  notes           String?
  doNotContact    Boolean   @default(false)
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([businessId])
  @@index([fullName])
  @@index([email])
  @@index([phone])
  @@index([archivedAt])
  @@map("clients")
}

// Services offered by the business
model Service {
  id              String   @id @default(cuid())
  businessId      String
  name            String
  description     String?
  priceCents      Int       @default(0)
  durationMinutes Int       @default(60)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([businessId])
  @@index([active])
  @@map("services")
}

// Optional add-ons that can be attached to a booking
model AddOn {
  id              String   @id @default(cuid())
  businessId      String
  name            String
  description     String?
  priceCents      Int       @default(0)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings BookingAddOn[]

  @@index([businessId])
  @@index([active])
  @@map("add_ons")
}

enum BookingStatus {
  BOOKED
  COMPLETED
  CANCELLED
}

// Bookings/Jobs for clients
model Booking {
  id          String         @id @default(cuid())
  businessId  String
  clientId    String
  serviceId   String?
  scheduledAt DateTime
  status      BookingStatus  @default(BOOKED)
  notes       String?
  totalCents  Int?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service  Service? @relation(fields: [serviceId], references: [id])
  addOns   BookingAddOn[]

  @@index([businessId])
  @@index([clientId])
  @@index([serviceId])
  @@index([scheduledAt])
  @@index([status])
  @@map("bookings")
}

// Join table for many-to-many between bookings and add-ons
model BookingAddOn {
  bookingId String
  addOnId   String

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addOn   AddOn   @relation(fields: [addOnId], references: [id], onDelete: Cascade)

  @@id([bookingId, addOnId])
  @@map("booking_add_ons")
}

// Message templates for automations (confirmation, reminder, review, rebook)
model MessageTemplate {
  id          String                @id @default(cuid())
  businessId  String
  type        MessageTemplateType
  subject     String?               // For email
  body        String                // Can contain variables like {client_name}, {booking_date}
  channel     MessageChannel
  enabled     Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  automationRules AutomationRule[]

  @@unique([businessId, type, channel])
  @@index([businessId])
  @@map("message_templates")
}

// Automation rules for triggering messages automatically
model AutomationRule {
  id          String      @id @default(cuid())
  businessId  String
  name        String
  triggerType TriggerType
  templateId  String
  enabled     Boolean     @default(true)
  
  // Configuration for timing-based triggers
  hoursOrDays Int?        // For HOURS_BEFORE_BOOKING or DAYS_SINCE_LAST_BOOKING
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  template MessageTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([enabled])
  @@index([triggerType])
  @@map("automation_rules")
}

enum MessageStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

// Message log to track all sent/queued messages
model MessageLog {
  id             String          @id @default(cuid())
  businessId     String
  clientId       String?
  bookingId      String?
  templateType   MessageTemplateType?
  channel        MessageChannel
  recipient      String          // email address or phone number
  subject        String?
  body           String
  status         MessageStatus   @default(QUEUED)
  errorMessage   String?
  sentAt         DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([businessId])
  @@index([clientId])
  @@index([bookingId])
  @@index([status])
  @@index([createdAt])
  @@map("message_logs")
}
